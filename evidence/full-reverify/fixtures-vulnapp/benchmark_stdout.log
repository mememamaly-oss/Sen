    "finding_id": "F-05671e9994",
    "type": "business_logic_cross_object_execution",
    "severity": "high",
    "attack_hypothesis": "a workflow step executes an object produced by a different flow/context",
    "preconditions": [
     "target reachable within scope",
     "a learned multi-step flow with resource linkage and a state oracle (workflow engine, learn phase)",
