// Burhan SaaS Platform schema (P0) — multi-tenant layer on top of the
// UNMODIFIED security engine (build-v411, tagged v4.1.1).
// Tenant isolation: every business row carries orgId and every query is
// membership-guarded at the API layer (src/lib/rbac.ts).
//
// P2-D (2026-10-31): PostgreSQL migration — provider moved from sqlite to
// postgresql. role/status/severity REMAIN String columns validated in code
// (RBAC_WHITELISTS in src/lib/rbac.ts) by design: single source of truth, and
// the guard survives even if the column type ever widens.
//
// P2-C: Finding.complianceJson carries the engine's OWASP/CWE/PCI DSS mapping
// (imported verbatim from result.json — never recomputed platform-side).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  targetsOwned Target[]
  scansRun     Scan[]
  reportsMade  Report[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  targets     Target[]
  scans       Scan[]
  findings    Finding[]
  reports     Report[]
  twins       TwinGraph[]
}

// role: OWNER | ADMIN | MEMBER | VIEWER  (RBAC in src/lib/rbac.ts)
model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String
  createdAt DateTime @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Target {
  id          String       @id @default(cuid())
  orgId       String
  createdById String
  name        String
  url         String
  description String?
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  scans       Scan[]
  findings    Finding[]

  @@index([orgId])
}

// status: QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
model Scan {
  id          String       @id @default(cuid())
  orgId       String
  targetId    String
  createdById String
  status      String
  optionsJson String       // snapshot of the options the operator chose
  runId       String? // engine run id (run-xxxxxxxx)
  scanner     String? // e.g. burhan-core/5.0.0
  statsJson   String? // full engine stats incl. coverage + boundary
  enginePid   Int?
  resultPath  String?
  logPath     String?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  durationSec Float?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  target      Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  findings    Finding[]
  reports     Report[]
  twin        TwinGraph[]

  @@index([orgId, createdAt])
  @@index([targetId, status])
}

model Finding {
  id               String       @id @default(cuid())
  orgId            String
  scanId           String
  targetId         String
  engineId         String // F-xxxxxxxxxx (engine identifier, stable per run)
  fingerprint      String? // engine store fingerprint (recurring analysis)
  type             String
  severity         String // critical | high | medium | low | info
  status           String // verified | candidate | ...
  confidence       Float
  risk             Int
  method           String?
  url              String
  parameter        String?
  evidenceJson     String // engine evidence chain (list of {kind, detail})
  verificationJson String // engine verification record
  impactJson       String // engine impact {grade, statement, safe_proof, evidence_chain}
  proofJson        String? // engine Evidence-OS proof (reproduction recipe) when present
  complianceJson   String? // P2-C: engine compliance mapping {cwe, owasp_2021, owasp_2025, pci_dss} — imported verbatim from result.json
  createdAt        DateTime     @default(now())
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scan             Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  target           Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([scanId, engineId])
  @@index([orgId, severity])
  @@index([orgId, type])
  @@index([scanId])
}

// format: HTML | JSON | SARIF | EXECUTIVE | GLASS
model Report {
  id          String       @id @default(cuid())
  orgId       String
  scanId      String?
  createdById String
  format      String
  title       String
  filePath    String
  sizeBytes   Int          @default(0)
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scan        Scan?        @relation(fields: [scanId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([orgId, createdAt])
}

// AUDIT-LOG IMMUTABILITY (owner order 2026-10-31, part 2.6): the trail is
// append-only AT THE DATABASE LEVEL — a BEFORE UPDATE OR DELETE trigger
// (migration 20261031_audit_immutable) rejects every mutation, so a
// compromised app-level account cannot erase or rewrite history. The
// orgId/userId columns are deliberately NOT foreign keys: an append-only
// trail must survive the deletion of the org/user it references (the old
// onDelete: SetNull silently REWROTE audit rows when an org was deleted).
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// PHASE 02 L1: normalized Security Twin — deterministic post-scan intelligence
// graph rebuilt from raw engine output (result.json / DB reconstruction).
// graphJson = the full NormalizedTwin (nodes/edges/conflicts/knownUnknowns/
// counts/twinHash); raw engine output is NEVER stored here as a substitute
// for normalization. Tenant isolation: unique(orgId, scanId) + every query
// org-scoped (persist.ts).
model TwinGraph {
  id                String   @id @default(cuid())
  orgId             String
  scanId            String
  twinSchemaVersion String
  contentHash       String   // twinHash — deterministic content hash
  countsJson        String
  graphJson         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scan              Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([orgId, scanId])
  @@index([orgId])
}

// SECURITY (audit 2026-10-23, bootstrap race): DB-level invariant that makes
// "exactly one platform bootstrap" impossible to race. The bootstrap
// transaction INSERTs the row with key "bootstrap" — a concurrent winner's
// unique-constraint violation (P2002) deterministically rejects every loser.
// The row also survives as a permanent marker that bootstrap is closed.
model PlatformLock {
  key       String   @id
  createdAt DateTime @default(now())
}

// SHARED-STORE RATE LIMITER (owner order 2026-10-31, part 2.9): the login
// brute-force guard and the public-demo guard previously kept their buckets
// in a process-local Map — per-process counters that are NOT enforced across
// processes. The buckets now live here, in the platform's existing
// PostgreSQL (no new dependency); every decision runs inside a transaction
// holding pg_advisory_xact_lock(hashtext(key)) so concurrent processes
// decide atomically. hitsJson = JSON array of epoch-ms hit timestamps
// (sliding window); blockedUntil persists the block past restarts.
model RateLimitBucket {
  key          String    @id
  hitsJson     String
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}
