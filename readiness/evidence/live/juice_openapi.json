{
 "openapi": "3.0.0",
 "info": {
  "title": "OWASP Juice Shop (authorized local deployment)",
  "version": "20.2.0"
 },
 "servers": [
  {
   "url": "http://localhost:3000"
  }
 ],
 "paths": {
  "/rest/products/search": {
   "get": {
    "summary": "product search",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/rest/products/{id}/reviews": {
   "get": {
    "summary": "product reviews",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/rest/basket/{id}": {
   "get": {
    "summary": "basket contents",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/rest/user/whoami": {
   "get": {
    "summary": "current user"
   }
  },
  "/rest/user/login": {
   "post": {
    "summary": "login",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "email": {
          "type": "string"
         },
         "password": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "/rest/saveLoginIp": {
   "get": {
    "summary": "save login IP"
   }
  },
  "/rest/continue-code": {
   "get": {
    "summary": "continue code"
   }
  },
  "/rest/admin/application-version": {
   "get": {
    "summary": "admin version info"
   }
  },
  "/rest/admin/application-configuration": {
   "get": {
    "summary": "admin config"
   }
  },
  "/rest/wallet/balance": {
   "get": {
    "summary": "wallet balance"
   }
  },
  "/api/Quantitys": {
   "get": {
    "summary": "quantitys"
   }
  },
  "/api/Cards": {
   "get": {
    "summary": "cards"
   }
  },
  "/api/Addresss": {
   "get": {
    "summary": "addresses"
   }
  },
  "/api/Deliverys": {
   "get": {
    "summary": "deliverys"
   }
  },
  "/api/Recalls": {
   "get": {
    "summary": "recalls"
   }
  },
  "/redirect": {
   "get": {
    "summary": "redirector",
    "parameters": [
     {
      "name": "to",
      "in": "query",
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/metrics": {
   "get": {
    "summary": "prometheus metrics"
   }
  },
  "/rest/coupons/{code}": {
   "get": {
    "summary": "coupon",
    "parameters": [
     {
      "name": "code",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/rest/languages": {
   "get": {
    "summary": "languages"
   }
  }
 }
}