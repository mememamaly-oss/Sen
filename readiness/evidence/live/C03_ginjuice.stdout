     }
    ],
    "identity": "primary scan session",
    "state_before": "",
    "state_after": "",
    "impact": {
     "grade": "proven",
     "statement": "A state-changing request from a hostile origin was accepted exactly like a same-origin one (fresh-origin replay) \u2014 silent cross-site action forgery against authenticated users.",
