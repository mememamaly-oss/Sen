    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.525.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
