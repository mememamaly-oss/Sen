{
  "name": "sentinel-saas",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "bash -c 'set -o pipefail; next dev -p 3000 2>&1 | tee dev.log'",
    "build": "next build --webpack && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "bash -c 'set -o pipefail; NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts tests/security.test.ts",
    "test:py": "python3 -m pytest tests/test_network_policy.py tests/test_engine_smoke.py -q",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "build:turbo": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "test:integration": "bash scripts/run_integration_tests.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.3.1",
