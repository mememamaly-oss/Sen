    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "lodash": "^4.17.23",
